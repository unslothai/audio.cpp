# Windows command scripts should use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unified patches need LF and single-space blank context lines.
scripts/unsloth/patches/*.patch text eol=lf whitespace=-blank-at-eol

# Binary, media, model, and archive files.
*.7z binary
*.bin binary
*.bmp binary
*.dll binary
*.dylib binary
*.exe binary
*.flac binary
*.gguf binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.onnx binary
*.png binary
*.safetensors binary
*.so binary
*.wav binary
*.webp binary
*.zip binary
